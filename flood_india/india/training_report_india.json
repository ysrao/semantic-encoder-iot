  "cleaning": {
    "spike_rule": "run of <=2 consecutive readings whose flanking readings agree within 0.5 m while every run reading deviates > 2.0 m from the flank median -> set to missing",
    "grid": "hourly 2020-01-01 00:00 to 2024-07-31 23:00 IST (40,176 h)",
    "gap_rule": "missing runs <= 4 h linearly interpolated; longer gaps stay missing; a window is used only if all 20 timesteps (16 window + 4 horizon) are present"
  },
  "windows": {
    "length": 16,
    "stride": 8,
    "horizon": 4,
    "label": "latched flood state (study GT latch: persist 2 above danger, onset backfilled, episode ends below danger - 0.3 m; state resets across gaps) active at any of the next 4 timesteps",
    "normalisation": "primary = level / station danger level; threshold channel = 1.0; rain = clip(rain_mm_h/20, 0, 3); temp = temp_C/50"
  },
